# Replace this public example with YOUR preprod address for ordinary payments.
SERVER_CARDANO_ADDRESS=addr_test1qp7573my7h0fyj9cd2fwrws5v6ep0e6urpx007pz0pjnmakny46m3vmfawqwv3m48dv2s6eysht6tjfdk48lrzrkmj5qpmyq7l

# The bundled facilitator. An alternative must advertise x402 v2 exact payments
# on cardano:preprod at GET /supported. The server checks it at startup.
FACILITATOR_URL=http://localhost:4022
PORT=4021

# Optional Masumi seller signing phrase. Blank uses the PUBLIC test phrase:
# test test test test test test test test test test test junk
# It needs no funds to sign offers; never use this public wallet for valuables.
# Masumi routes lock real preprod funds in escrow. This demo has no release or
# refund workflow, and its x402 termsDigest signatures are incompatible with the
# stock Masumi Payment Service lifecycle APIs. Use the ordinary ADA route first.
MASUMI_SELLER_MNEMONIC=
# Connect a different buyer wallet for Masumi: buyer and seller payout
# addresses must differ, even though ordinary ADA self-payments can work.

# Optional native token override: policyId.assetNameHex. Blank/unset uses the
# official USDM_PREPROD_ASSET. The wallet must hold this exact token.
#USDM_ASSET=

# Optional initial confirmation level within the facilitator's advertised range.
# Default: 1, clamped into that range. Runtime controls can change this default;
# existing paid retries keep their original level in the request URL.
#L1_CONFIRMATIONS=1

# Optional per-call facilitator HTTP timeout. Default: at least 120000ms and
# 45000ms above the wait advertised by /health (assumes 75000ms if unavailable).
# An override must exceed the wait by at least 15000ms.
#FACILITATOR_TIMEOUT_MS=120000
