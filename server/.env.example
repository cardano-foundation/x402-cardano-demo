# Replace this public example with YOUR preprod address for ordinary payments.
SERVER_CARDANO_ADDRESS=addr_test1qp7573my7h0fyj9cd2fwrws5v6ep0e6urpx007pz0pjnmakny46m3vmfawqwv3m48dv2s6eysht6tjfdk48lrzrkmj5qpmyq7l

# The bundled facilitator. An alternative must advertise x402 v2 exact payments
# on cardano:preprod at GET /supported. The server checks it at startup.
FACILITATOR_URL=http://localhost:4022
PORT=4021

# Optional native token override: policyId.assetNameHex. Blank/unset uses the
# official USDM_PREPROD_ASSET. The wallet must hold this exact token.
#USDM_ASSET=

# Optional initial confirmation level within the facilitator's advertised range.
# Default: 1, clamped into that range. Runtime controls can change this default;
# existing paid retries keep their original level in the request URL.
#L1_CONFIRMATIONS=1

# Optional per-call facilitator HTTP timeout. Default: at least 120000ms and
# 45000ms above the wait advertised by /health (assumes 75000ms if unavailable).
# An override must exceed the wait by at least 15000ms.
#FACILITATOR_TIMEOUT_MS=120000

# -- Masumi tab --------------------------------------------------------------
# The Masumi agent (masumi/: npm run agent). The tab's x402 purchase and job
# status are forwarded there; it holds the seller key, not this server.
#MASUMI_AGENT_URL=http://127.0.0.1:8787

# The demo frontend's exact origins: the only callers allowed to use the
# Sokosumi proxy below. Comma-separated scheme://host:port, no trailing slash.
#FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: hire the agent through Sokosumi from the Masumi tab. The key is
# your Sokosumi user API key; it spends your credits and never reaches the
# browser. Never tunnel or expose this server while it is set.
#SOKOSUMI_API_KEY=
# Required with the key, so the catalog lookup cannot pick someone else's
# agent: Sokosumi's own agent id (preferred; a UUID, not MASUMI_AGENT_IDENTIFIER)
# or your agent's exact AGENT_NAME.
#SOKOSUMI_AGENT_ID=
#SOKOSUMI_AGENT_NAME=
# Optional cap on credits per hire, the organization to bill, and the API URL.
#SOKOSUMI_MAX_CREDITS=
#SOKOSUMI_ORGANIZATION_SLUG=
#SOKOSUMI_API_URL=https://api.preprod.sokosumi.com/v1
