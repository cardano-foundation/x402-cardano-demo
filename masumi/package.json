{
  "name": "masumi-x402-agent-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Masumi agent on Cardano preprod, hireable via Sokosumi (standard Masumi flow) and via x402. Its demo UI is the main demo's Masumi tab.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "agent": "tsx watch src/agent.ts",
    "register": "tsx src/scripts/register.ts",
    "deregister": "tsx src/scripts/deregister.ts",
    "collect": "tsx src/scripts/collect.ts",
    "check-quote": "tsx src/scripts/check.ts quote",
    "check-purchase": "tsx src/scripts/check.ts purchase",
    "check-registry": "tsx src/scripts/check.ts registry",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@evolution-sdk/evolution": "0.5.13",
    "@noble/hashes": "2.4.0",
    "@x402/cardano": "2.26.0",
    "@x402/core": "2.26.0",
    "@x402/express": "2.26.0",
    "canonical-json": "0.2.0",
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "lz-string": "1.5.0"
  },
  "devDependencies": {
    "@meshsdk/core-cst": "1.9.0-beta.90",
    "@types/express": "4.17.25",
    "@types/node": "22.20.4",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "zod": "3.25.76"
  }
}
