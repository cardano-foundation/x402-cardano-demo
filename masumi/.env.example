# ---- Required ---------------------------------------------------------------
# Blockfrost project id for Cardano PREPROD (https://blockfrost.io).
BLOCKFROST_PROJECT_ID=preprodXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# The selling wallet (24 words). It signs purchase terms and escrow
# transactions and holds the registry NFT. Fund it with ~20 tADA.
# Never reuse a wallet that holds real funds.
SELLER_MNEMONIC=
# Public HTTPS base URL of this agent (no trailing slash), e.g. a named
# Cloudflare tunnel. The Masumi registry health check and Sokosumi call it.
# It is written into the registry NFT, so choose a stable one before registering.
AGENT_PUBLIC_URL=https://my-agent.example.com

# ---- Set after `npm run register` -------------------------------------------
MASUMI_AGENT_IDENTIFIER=

# ---- Optional ---------------------------------------------------------------
# Price in tUSDM base units (6 decimals): 1000000 = 1 tUSDM. Registered on
# chain; change it only together with a new registration.
PRICE_TUSDM_UNITS=1000000
# Optional x402-only price in lovelace (5000000 = 5 tADA). It is NOT in the
# registry, so this offer carries no agent identifier; buyers skip the registry
# check for it. Leave empty to offer only the registered tUSDM price.
X402_ADA_PRICE_LOVELACE=5000000
PORT=8787
# How the agent appears in the Masumi registry and the Sokosumi catalog.
# These are written into the registry NFT by `npm run register`, so set them
# before registering. To change them later: npm run deregister, edit here,
# npm run register, then update MASUMI_AGENT_IDENTIFIER.
AGENT_NAME=x402 Masumi demo agent
AGENT_DESCRIPTION=Demo agent: reverses and upper-cases your text. Pays via Masumi escrow or x402.
AGENT_AUTHOR=x402 Cardano demo
AGENT_TAGS=demo,text,x402
# AGENT_IMAGE=ipfs://QmXXW7tmBgpQpXoJMAMEXXFe9dyQcrLFKGuzxnHDnbKC7f
# BLOCKFROST_BASE_URL=https://cardano-preprod.blockfrost.io/api/v0
