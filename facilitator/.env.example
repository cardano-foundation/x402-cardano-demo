# Required: a Blockfrost PREPROD project ID, from https://blockfrost.io.
# The official signer queries inputs/protocol parameters and broadcasts the
# client's signed transaction. No wallet, mnemonic or private key is needed.
BLOCKFROST_PROJECT_ID=

PORT=4022
BLOCKFROST_BASE_URL=https://cardano-preprod.blockfrost.io/api/v0

# Opt in to confirmation level -1: accept the facilitator's own successful
# broadcast response. Mempool acceptance can be rolled back. Default range: 0..20.
ACCEPT_MEMPOOL=false

# Bounded wait per /settle call. The official core retries settlement once with
# the same payload when it returns settlement_pending. Deeper confirmation
# settings may then require the browser's Check this payment again action.
# GET /health publishes this budget so the resource server can size its timeout.
CONFIRMATION_TIMEOUT_MS=75000
