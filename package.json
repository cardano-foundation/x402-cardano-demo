{
  "name": "x402-cardano-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": ["facilitator", "server", "frontend"],
  "scripts": {
    "dev": "concurrently --kill-others --names facilitator,server,web \"npm run dev -w facilitator\" \"npm run dev -w server\" \"npm run dev -w frontend\"",
    "typecheck": "npm run typecheck --workspaces && tsc -p tsconfig.tests.json",
    "build": "npm run build -w frontend",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "verify:docs": "sh docs/x402/verify-docs.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "concurrently": "10.0.5",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
